# Production settings (copy to .env for local use; on Render these are set via the dashboard/render.yaml).
# Set DATABASE_URL=postgres://user:pass@host:5432/osm?sslmode=require for PostgreSQL.
# Leave DATABASE_URL out to use a local SQLite file.
POSTGRES_PASSWORD=change-me
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=
REDIRECT_URI=https://your-domain.example/auth/callback
WEB_ORIGIN=https://your-domain.example
# openssl rand -base64 32
TOKEN_ENC_KEY=
